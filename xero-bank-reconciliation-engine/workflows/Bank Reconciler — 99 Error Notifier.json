    {
      "parameters": {
        "fromEmail": "REPLACE_WITH_FROM_EMAIL",
        "toEmail": "REPLACE_WITH_TO_EMAIL",
        "subject": "={{ '[Payout Reconciler] Workflow failed: ' + $('Extract Error Context').item.json.workflow_name }}",
        "html": "=<!DOCTYPE html>\n<html><body style=\"margin:0;padding:0;background:#F9F8F6;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#1A1D23;\">\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"background:#F9F8F6;padding:40px 16px;\">\n<tr><td align=\"center\">\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"560\" style=\"max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #EAE9E4;\">\n<tr><td style=\"background:#7F1D1D;padding:20px 32px;\"><div style=\"font-weight:700;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;color:#FCA5A5;\">Payout Reconciler error, action needed</div></td></tr>\n<tr><td style=\"padding:32px;\">\n<h1 style=\"margin:0 0 8px;font-size:22px;font-weight:700;line-height:1.2;color:#1A1D23;\">A workflow failed</h1>\n<p style=\"margin:0 0 24px;font-size:14px;color:#6B7280;line-height:1.6;\">An execution of the Payout Reconciler errored. Details below.</p>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"margin:0 0 24px;border-collapse:collapse;\">\n<tr><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.05em;width:130px;vertical-align:top;\">Workflow</td><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:14px;color:#1A1D23;\">{{ $('Extract Error Context').item.json.workflow_name }}</td></tr>\n<tr><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.05em;vertical-align:top;\">Failed node</td><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:14px;color:#1A1D23;font-weight:600;\">{{ $('Extract Error Context').item.json.failed_node }}</td></tr>\n<tr><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.05em;vertical-align:top;\">Error</td><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-family:Consolas,Monaco,monospace;font-size:13px;color:#7F1D1D;background:#FEF2F2;padding:10px 12px;border-radius:6px;\">{{ $('Extract Error Context').item.json.error_message }}</td></tr>\n<tr><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.05em;vertical-align:top;\">Processor</td><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:14px;color:#1A1D23;\">{{ $('Extract Error Context').item.json.processor }}</td></tr>\n<tr><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.05em;vertical-align:top;\">Payout</td><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:14px;color:#1A1D23;\">{{ $('Extract Error Context').item.json.payout_id }}</td></tr>\n<tr><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.05em;vertical-align:top;\">Time</td><td style=\"padding:10px 0;border-bottom:1px solid #EAE9E4;font-size:14px;color:#1A1D23;\">{{ $('Extract Error Context').item.json.failed_at }}</td></tr>\n<tr><td style=\"padding:10px 0;font-size:12px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.05em;vertical-align:top;\">Mode</td><td style=\"padding:10px 0;font-size:14px;color:#1A1D23;\">{{ $('Extract Error Context').item.json.execution_mode }}</td></tr>\n</table>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:0 0 8px;\"><tr><td style=\"background:#1A1D23;border-radius:8px;\"><a href=\"{{ $('Extract Error Context').item.json.execution_url }}\" style=\"display:inline-block;padding:12px 24px;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;\">View execution in n8n</a></td></tr></table>\n<p style=\"margin:24px 0 0;font-size:11px;color:#9CA3AF;line-height:1.6;\">Execution ID: {{ $('Extract Error Context').item.json.execution_id }}<br>Audit row logged to payment_recon.posting_events if a payouts row existed for this run.</p>\n</td></tr></table></td></tr></table></body></html>",
        "options": {}
