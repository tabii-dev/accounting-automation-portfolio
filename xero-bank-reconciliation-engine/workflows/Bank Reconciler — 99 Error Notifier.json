      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        400,
        336
      ],
      "id": "ce4d2d1c-5d35-42df-8e53-28d0b5b3c665",
      "name": "Extract Error Context"
    },
    {
      "parameters": {
        "content": "**Extract Error Context**\n\nReads from the failed execution's runData to extract processor + payout_id + workflow_run_id from whichever Run Context node ran (Stripe or Shopify). Falls back to 'unknown' if neither ran.\n\nThis is the only place the failure-context propagates from inside WF01 to here.",
        "height": 360,
        "width": 432,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        128,
        144
      ],
      "id": "b46f38ac-98c6-40df-b184-6b245323722d",
      "name": "Note: Extract Context"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO payment_recon.posting_events (payout_uuid, workflow_run_id, event_type, event_data)\nSELECT p.id, COALESCE(NULLIF($1, 'unknown')::uuid, gen_random_uuid()), 'ERROR', $2::jsonb\nFROM payment_recon.payouts p\nWHERE p.processor = $3 AND p.payout_id = $4\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.workflow_run_id, JSON.stringify({ workflow_name: $json.workflow_name, failed_node: $json.failed_node, error_message: $json.error_message, error_stack: $json.error_stack, execution_id: $json.execution_id, execution_url: $json.execution_url, execution_mode: $json.execution_mode, failed_at: $json.failed_at }), $json.processor, $json.payout_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        640,
        336
      ],
      "id": "3e49b5e3-8f61-49fe-a4ef-777ed4a57a9d",
      "name": "Log ERROR event",
      "credentials": {
        "postgres": {
          "id": "muw5AAZhByttMOgd",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "content": "**Log ERROR event**\n\nWrites an ERROR row to `payment_recon.posting_events` linked to the payouts row (by processor + payout_id) if one exists. If the failure happened before a payouts row was inserted (e.g. signature failure), the LIMIT 1 returns nothing and no row is written. That's intentional: errors with no payout context skip the audit table and only fire Slack/email.\n\nCredential placeholder, replace on import.",
        "height": 528,
        "width": 496,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        592,
        64
      ],
      "id": "b03139a4-28ca-44d1-9eaa-f14fb5c9d439",
      "name": "Note: Log ERROR"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "REPLACE_WITH_CHANNEL_ID",
          "mode": "list",
          "cachedResultName": "recon-errors"
        },
        "text": "=🚨 *Payout Reconciler error*\n\n*Workflow*: {{ $('Extract Error Context').item.json.workflow_name }}\n*Failed node*: {{ $('Extract Error Context').item.json.failed_node }}\n*Error*: {{ $('Extract Error Context').item.json.error_message }}\n\n*Context*\n- Processor: {{ $('Extract Error Context').item.json.processor }}\n- Payout: {{ $('Extract Error Context').item.json.payout_id }}\n- Run ID: {{ $('Extract Error Context').item.json.workflow_run_id }}\n- Mode: {{ $('Extract Error Context').item.json.execution_mode }}\n- Failed at: {{ $('Extract Error Context').item.json.failed_at }}\n\n<{{ $('Extract Error Context').item.json.execution_url }}|View execution in n8n>",
        "otherOptions": {}
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [
        880,
        448
      ],
      "id": "d50e5989-21c5-47b9-8cb5-36ce544af33b",
      "name": "Alert Team",
      "webhookId": "32d036d4-a6ef-4638-b36b-7953374d4037",
      "credentials": {
        "slackOAuth2Api": {
          "id": "blM8swqMgVe0rXSW",
