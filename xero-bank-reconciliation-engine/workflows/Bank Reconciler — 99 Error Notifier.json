              "name": "processor",
              "value": "={{ $json.execution.data?.resultData?.runData?.['Set Stripe Run Context']?.[0]?.data?.main?.[0]?.[0]?.json?.processor || $json.execution.data?.resultData?.runData?.['Set Shopify Run Context']?.[0]?.data?.main?.[0]?.[0]?.json?.processor || 'unknown' }}",
              "type": "string"
            },
            {
              "id": "a11",
              "name": "payout_id",
              "value": "={{ $json.execution.data?.resultData?.runData?.['Set Stripe Run Context']?.[0]?.data?.main?.[0]?.[0]?.json?.payout_id || $json.execution.data?.resultData?.runData?.['Set Shopify Run Context']?.[0]?.data?.main?.[0]?.[0]?.json?.payout_id || 'unknown' }}",
              "type": "string"
            },
            {
              "id": "a12",
              "name": "workflow_run_id",
              "value": "={{ $json.execution.data?.resultData?.runData?.['Set Stripe Run Context']?.[0]?.data?.main?.[0]?.[0]?.json?.workflow_run_id || $json.execution.data?.resultData?.runData?.['Set Shopify Run Context']?.[0]?.data?.main?.[0]?.[0]?.json?.workflow_run_id || 'unknown' }}",
              "type": "string"
            }
          ]
